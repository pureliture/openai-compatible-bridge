# 서비스 계정 키 경로 (ADC). Vertex AI User(roles/aiplatform.user) 권한 필요.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/vertex-sa.json

# GCP 프로젝트 / 리전
VERTEX_PROJECT=your-gcp-project
VERTEX_LOCATION=us-central1

# Vertex embedding 호출 기본 task_type
VERTEX_TASK_TYPE_DEFAULT=RETRIEVAL_DOCUMENT

# 입력 토큰 초과 시 자동 절단 (false면 한도 초과 시 400)
VERTEX_AUTO_TRUNCATE=true

# bridge 보호용 키. 설정 시 client의 API-Key 칸에 동일 값 입력. 같은 private network면 비워도 됨.
BRIDGE_API_KEY=

# 클라이언트가 stream_options를 생략해도 스트리밍 마지막 청크에 usage를 기본 방출할지 여부 (기본 false, OpenAI 공식 스펙 준수)
STREAM_INCLUDE_USAGE_DEFAULT=false

# 토큰 만료 몇 초 전에 선갱신할지
TOKEN_REFRESH_SKEW_SECONDS=300

# Vertex 동시 호출 상한 / HTTP 타임아웃
MAX_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=60

# Ollama native API base URL. Docker에서 host Ollama를 쓰면 host.docker.internal을 사용한다.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama 전용 HTTP 타임아웃. 비우면 HTTP_TIMEOUT_SECONDS를 따른다.
OLLAMA_HTTP_TIMEOUT_SECONDS=
# Ollama thinking mode 기본값. 요청별 reasoning_effort 또는 reasoning.effort가 있으면 해당 요청에서 override된다.
# env 값은 true/false/low/medium/high/omit 지원. 요청 값은 high/medium/low/none 지원.
OLLAMA_THINK=true

# Dynamic Ollama Cloud json_schema 실패 시 bridge boundary에서 validate -> repair chain -> final validate 수행.
# 기본 OFF. 켜면 아래 모델을 순서대로 최대 3회 추가 호출하고, 최종 JSON schema validation 통과 시에만 200 반환.
STRUCTURED_OUTPUT_REPAIR_ENABLED=false
STRUCTURED_OUTPUT_REPAIR_MODELS=ollama:qwen3.5:cloud,ollama:gemma4:31b-cloud,ollama:glm-5.2:cloud

# KNOWN_MAX_INSTANCES에 없는 모델의 요청당 instance 폴백(안전값 1)
DEFAULT_MAX_INSTANCES=1

# 허용 모델 화이트리스트 추가(쉼표구분). 기본 3개 외 Vertex 임베딩 모델을 쓸 때만 추가.
# 여기 없는 model 이름은 404로 거부됨(path 주입 방지). 예: EXTRA_MODELS=text-embedding-004
EXTRA_MODELS=

# provider/kind/provider_model 기반 model alias registry override JSON.
# 예: {"llama-local":{"provider":"ollama","kind":"chat","provider_model":"llama3.1"}}
MODEL_REGISTRY_JSON=

# Foundry OpenAI-compatible endpoint. URL은 deployment config로 고정하고 요청 입력으로 받지 않는다.
# protocol=google_generate_content alias는 이 URL의 host/root에서 Google native 경로를 파생한다.
FOUNDRY_BASE_URL=
# Foundry bearer token. 실제 값은 .env 또는 Kubernetes Secret에만 저장한다.
FOUNDRY_TOKEN=
# Foundry 전용 HTTP timeout. 비우면 HTTP_TIMEOUT_SECONDS를 따른다.
FOUNDRY_HTTP_TIMEOUT_SECONDS=

# 비용 추적 / forecast budget gate. false는 명시적 보호 해제 상태다.
# *_LIMIT_USD=unlimited는 예산 한도 차단만 해제하며 분류/가격/DB 검사는 유지한다.
COST_TRACKING_ENABLED=false
# 구현된 provider(vertex/ollama/foundry)의 실제 payer 계약을 운영자가 확인해 명시한다.
# 허용 분류: metered / subscription / nonbillable. 추정 기본값은 없다.
# 예: {"vertex":"metered"}는 Vertex 계약이 종량제일 때만 사용한다.
# tracking=true일 때 빈 값/누락/알 수 없는 분류의 경로는 fail-closed다.
# provider 전체 credential/baseURL 경로에 적용하므로 계약 혼합은 별도 deployment로 분리한다.
COST_PROVIDER_BILLING_JSON=
# legacy 호환 키. 새 runtime은 이 값을 무시하며 billing map으로만 판정한다.
COST_TRACKING_PROVIDERS=
# sqlite는 로컬 호환 기본값이며 multi-pod 공유 예산 보장은 없다.
# PostgreSQL 단일 authority 사용 시 postgres를 명시한다. SQLite fallback은 없다.
COST_LEDGER_BACKEND=sqlite
# 전용 bridge DB의 runtime 자격증명을 외부에서 주입한다. 실제 DSN은 저장소에 넣지 않는다.
# schema-only CLI 실행 시에만 같은 환경 변수에 migrator 자격증명을 주입한다.
COST_LEDGER_POSTGRES_DSN=
# 아래 경로는 SQLite용이다. postgres 선택 시 파일을 열지 않으며 기존 데이터도 삭제하지 않는다.
COST_LEDGER_PATH=/data/cost-ledger.db
COST_LEDGER_DIR=./data
# metered는 chat input/output, embeddings embedding, rerank per-unit 가격을 모두 명시해야 한다.
# 유효한 subscription/nonbillable 분류는 가격/비용 설정/DB 장애와 무관하게 완전히 우회한다.
COST_PRICING_JSON=
COST_PRICING_PATH=
COST_CHAT_DEFAULT_MAX_OUTPUT_TOKENS=4096
COST_SHORT_WINDOW_SECONDS=
COST_SHORT_WINDOW_LIMIT_USD=
COST_DAILY_LIMIT_USD=

# 비용 admin API. BRIDGE_API_KEY와 별도 키를 사용한다.
COST_ADMIN_ENABLED=false
COST_ADMIN_API_KEY=

# Cloud Billing BigQuery reconciliation. export 설정/권한은 별도 운영 작업으로 준비한다.
COST_RECONCILIATION_ENABLED=false
COST_BILLING_BIGQUERY_PROJECT=
COST_BILLING_BIGQUERY_DATASET=
COST_BILLING_BIGQUERY_TABLE=
COST_RETENTION_REQUEST_DAYS=90
COST_RETENTION_AGGREGATE_MONTHS=13
